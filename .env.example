# Required for application import and startup.
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Required for the AI chat, search, embedding, and generated-report features.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Required by password-reset/session-revocation administration endpoints.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Required when serving lectures stored in Bunny Stream.
BUNNY_STREAM_LIBRARY_ID=YOUR_BUNNY_STREAM_LIBRARY_ID
BUNNY_STREAM_API_KEY=YOUR_BUNNY_STREAM_API_KEY
BUNNY_STREAM_CDN_HOSTNAME=YOUR_PULL_ZONE_HOSTNAME

# Safe production defaults.
ENABLE_DEMO_UI=false
# Set true only when intentionally publishing the doctor-authenticated grading
# evaluation UI and /api/grading-demo endpoints.
ENABLE_GRADING_DEMO_UI=false
ENFORCE_SUBSCRIPTIONS=true
LOG_LEVEL=INFO
REPORT_TIMEZONE=Africa/Cairo

# Optional model and retrieval tuning. Omit to use application defaults.
# EMBED_MODEL=gemini-embedding-2
# EMBED_DIM=1536
# CHAT_MODEL=gemini-3.1-flash-lite
# CHAT_FALLBACK_MODEL=gemini-2.5-flash
# ESSAY_CRITERIA_MODEL=gemini-3.1-flash-lite
# ESSAY_EVALUATOR_MODEL=gemini-3.1-flash-lite
# TOP_K=4
# MAX_DISTANCE=0.45

# Not used by this FastAPI runtime: JWT_SECRET, JWT_ALGORITHM,
# ACCESS_TOKEN_MINUTES, SUPABASE_DATABASE_URL, SUPABASE_JWKS_URL, HF_TOKEN.
