# Required for application import and startup.
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Must exactly match Nest's JWT_ACCESS_SECRET (minimum 32 characters).
# Server-only: never expose this value to a browser or client bundle.
NEST_JWT_ACCESS_SECRET=YOUR_NEST_JWT_ACCESS_SECRET_AT_LEAST_32_CHARACTERS

# Required for the AI chat, search, embedding, and generated-report features.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Required by password-reset/session-revocation administration endpoints.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Required when serving lectures stored in Bunny Stream.
BUNNY_STREAM_LIBRARY_ID=YOUR_BUNNY_STREAM_LIBRARY_ID
BUNNY_STREAM_API_KEY=YOUR_BUNNY_STREAM_API_KEY
# The pull zone's URL Token Authentication Key, from
#   CDN > the pull zone for this Stream library > Security > Token Authentication
# NOT the "Token Authentication Key" on the Stream library's own Security page:
# that one signs iframe embed views and a direct file URL signed with it is
# refused exactly like an unsigned one.
BUNNY_STREAM_TOKEN_AUTH_KEY=
# "advanced" (HMAC-SHA256, current default) or "basic" (MD5). Bunny has no
# other format. Run
#   python -m rag.bunny check-token-auth <video-guid>
# and it will report which this pull zone accepts.
BUNNY_TOKEN_AUTH_ALGORITHM=advanced
# How long a signed media URL lives, in seconds. Default 1800 (30 minutes).
# Minted immediately before RunPod submission, so this covers the RunPod queue,
# a cold start, the download and the transcription.
BUNNY_MEDIA_URL_TTL_SECONDS=
# Sent as the Referer when ffmpeg fetches a lecture. Needed only when Bunny's
# "Block Direct URL File Access" requires a referring domain even from a
# request carrying a valid token — a serverless GPU sends no Referer of its
# own. Must be a domain on the Stream library's Allowed domains list. Unset
# means no Referer is sent, which is the previous behaviour.
# Set this on the RunPod endpoint, not only on the API server: it is ffmpeg,
# inside the GPU worker, that makes the request.
BUNNY_MEDIA_REFERER=

BUNNY_STREAM_CDN_HOSTNAME=YOUR_PULL_ZONE_HOSTNAME

# Automatic transcription: Bunny calls the API when a video finishes encoding,
# and the worker submits it to a RunPod Serverless GPU exactly once.
#
# Bunny signs nothing, so this secret in the webhook URL is the only thing
# separating the endpoint from anyone who guesses the path. Treat the whole
# configured URL as a credential. Generate with: openssl rand -hex 32
BUNNY_WEBHOOK_SECRET=YOUR_BUNNY_WEBHOOK_SECRET

# Where the Cohere Arabic ASR runs. "runpod" submits to RunPod Serverless, which
# starts a GPU on demand and scales back to zero when idle; "cohere" loads the
# model in this process and needs a local GPU plus the full requirements.txt.
ASR_BACKEND=runpod

# The RunPod Serverless endpoint. The endpoint id is the one in its URL; the API
# key is account-wide and must never reach a browser.
RUNPOD_API_KEY=YOUR_RUNPOD_API_KEY
RUNPOD_ENDPOINT_ID=YOUR_RUNPOD_ENDPOINT_ID

# How often the worker asks RunPod whether a submitted job has finished, and how
# long a job may stay unfinished before this side gives up and retries it.
RUNPOD_POLL_INTERVAL_SECONDS=15
RUNPOD_JOB_TIMEOUT_SECONDS=3600
RUNPOD_REQUEST_TIMEOUT_SECONDS=60

# Which checkpoint the GPU worker loads. Set here as well as on the worker so
# the two cannot silently disagree about which transcript they produce.
COHERE_TRANSCRIBE_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026

# How many times a failing transcription is retried before it is abandoned, and
# how long a claimed job may sit unfinished before another worker may take it
# (crash recovery, not a limit on how long a lecture may take).
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_STALE_MINUTES=120

# Only needed to BUILD the GPU worker image, and only if the model repository
# is gated. It belongs on the build machine, never in the deployed API's
# environment and never in a committed file — see gpu/README.md.
# HF_TOKEN=YOUR_HUGGING_FACE_TOKEN

# Safe production defaults.
ENABLE_DEMO_UI=false
# Set true only when intentionally publishing the authenticated grading
# evaluation UI and /api/grading-demo endpoints.
ENABLE_GRADING_DEMO_UI=false
ENFORCE_SUBSCRIPTIONS=true
LLM_DAILY_QUERY_LIMIT=10
LOG_LEVEL=INFO
REPORT_TIMEZONE=Africa/Cairo

# Optional model and retrieval tuning. Omit to use application defaults.
# EMBED_MODEL=gemini-embedding-2
# EMBED_DIM=1536
# CHAT_MODEL=gemini-3.1-flash-lite
# CHAT_FALLBACK_MODEL=gemini-2.5-flash
# ESSAY_CRITERIA_MODEL=gemini-3.1-flash-lite
# ESSAY_EVALUATOR_MODEL=gemini-3.1-flash-lite
# TOP_K=4
# MAX_DISTANCE=0.45

# Not used by this FastAPI runtime: JWT_SECRET, JWT_ALGORITHM,
# ACCESS_TOKEN_MINUTES, SUPABASE_DATABASE_URL, SUPABASE_JWKS_URL, HF_TOKEN.
