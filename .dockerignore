# Production normally has no demo frontend. Keep only the authenticated essay
# grading page and the existing login/session assets it needs when its dedicated
# feature flag is enabled; the general student demo remains outside the image.
app/static/*
!app/static/grading-demo.html
!app/static/grading-demo.js
!app/static/grading-demo.css
!app/static/auth.js
!app/static/styles.css
!app/static/login.html
!app/static/login.js
!app/static/login.css
local_backup.sql
supabase_restore.sql
*.sql
*.dump
transcripts

# Supabase CLI state and local/nested repositories
supabase
supabase/.temp
way2APlus_db
**/.git

# Offline RAG/ML pipeline: retain only the Bunny HTTP helper used by the API.
rag/*
!rag/__init__.py
!rag/bunny.py

# Editor/search experiments not used by the runtime search endpoint.
search-assistant/__pycache__
